# Copy to .env and fill in. Never commit .env.
# Every setting the gateway reads is listed here.

# --- Upstream API keys ------------------------------------------------------
# Free key: https://data.bls.gov/registrationEngine/
#   with key: 500 queries/day, 50 series and 20 years per query
#   without:   25 queries/day, 25 series and 10 years per query
BLS_API_KEY=
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html (required for FRED series and search)
FRED_API_KEY=
# bls.gov refuses anonymous scripts for OEWS bulk files; identify yourself:
BLS_USER_AGENT=

# --- Local data (defaults shown) ------------------------------------------------
# CACHE_DIR=data/cache          # API response cache and parsed OEWS tables
# RAW_DIR=data/raw              # downloaded OEWS zip files
# CACHE_TTL_HOURS=12            # cache lifetime for series with no known release schedule
# CATALOG_PATH=                 # alternative series catalog CSV (default: the shipped one)

# --- Gateway settings ---------------------------------------------------------
# Log level for stderr logs: DEBUG | INFO | WARNING | ERROR
ECON_LOG_LEVEL=WARNING
# Comma-separated toolsets to enable: core, wages, regional, compute (core is always added)
ECON_TOOLSETS=core,wages,regional,compute
# Transport used by `econ-gateway` with no flags: stdio | http
ECON_TRANSPORT=stdio
# HTTP transport only. A non-loopback host needs ECON_AUTH_MODE=jwt (or the explicit opt-out below).
ECON_HOST=127.0.0.1
ECON_PORT=8000
# ECON_HTTP_PATH=/mcp
# ECON_STATELESS_HTTP=true

# --- HTTP authentication (docs/DEPLOYMENT.md) ---------------------------------
# ECON_AUTH_MODE=jwt
# One key source: a JWKS URL, an inline PEM key, or a PEM file.
# ECON_JWT_JWKS_URI=https://your-issuer.example.com/.well-known/jwks.json
# ECON_JWT_PUBLIC_KEY=
# ECON_JWT_PUBLIC_KEY_FILE=
# ECON_JWT_ISSUER=https://your-issuer.example.com/
# ECON_JWT_AUDIENCE=econ-gateway
# ECON_JWT_ALGORITHM=RS256
# ECON_JWT_REQUIRED_SCOPES=
# Extra Host / Origin values accepted (loopback is always accepted).
# ECON_ALLOWED_HOSTS=econ.example.com
# ECON_ALLOWED_ORIGINS=
# Only when a proxy in front already authenticates every request:
# ECON_ALLOW_UNAUTHENTICATED_REMOTE=false

# --- Tracing (pip install -e ".[otel]") ---------------------------------------
# ECON_TELEMETRY=off            # off | otlp | console (console prints to stderr)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Runtime state that must survive restarts (the BLS daily query count). Default: ./.state
# ECON_STATE_DIR=.state

# --- Evals (Phase 6; evals/ only, never used by the server) --------------------
# The eval client calls an LLM through the OpenAI-compatible API.
#   openai: uses OPENAI_API_KEY; billed per token
#   ollama: a local server at http://localhost:11434/v1; pull a tool-capable model first
# EVAL_PROVIDER=openai
# EVAL_MODEL=gpt-4.1-mini
# EVAL_BASE_URL=
# OPENAI_API_KEY=
